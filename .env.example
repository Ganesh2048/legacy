# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=legacy_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/legacy_db?schema=public"

# Backend Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_legacy_2026_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_legacy_2026_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN="http://localhost:3000"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="Legacy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage (AWS S3 / S3-Compatible Storage)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET_NAME=legacy-family-media
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
